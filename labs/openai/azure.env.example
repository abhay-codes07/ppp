# Copy OUTSIDE the repository, fill in, then load it in Git Bash:
#   cp labs/openai/azure.env.example ~/.petriflow-azure.env
#   chmod 600 ~/.petriflow-azure.env
#   set -a; source ~/.petriflow-azure.env; set +a
# Never commit the filled copy. The repo's .gitignore already ignores .env files.

AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=<deployment-name-from-the-admin>
AZURE_TENANT_ID=<tenant-guid>
AZURE_CLIENT_ID=<app-registration-client-guid>
AZURE_CLIENT_SECRET=<client-secret-value>

# Only if you were handed a resource key instead of a service principal:
# AZURE_OPENAI_API_KEY=<key>

# Only behind a corporate proxy:
# HTTPS_PROXY=http://proxy.<company-domain>:8080
